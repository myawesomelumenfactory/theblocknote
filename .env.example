# Local indexer / Vite proxy. Do not prefix with VITE_ (that would ship them to the browser).
# For GitHub Actions, add the same names as repository secrets so CI can use enterprise.
BLOCKSTREAM_CLIENT_ID=
BLOCKSTREAM_CLIENT_SECRET=

# Local immutables service (npm run immutables:service)
# IMMUTABLES_POLL_MS=60000
# IMMUTABLES_HTTP_PORT=8788
# IMMUTABLES_HTTP_HOST=127.0.0.1
# Later, when hosting: bind 0.0.0.0 and set one of these to publish immutables.json to IPFS.
# IPFS_API=http://127.0.0.1:5001
# PINATA_JWT=

# The static page bakes data/immutables.json and data/immutables-state.json into
# the bundle, copies them into localStorage, then catches up from mempool.space.
